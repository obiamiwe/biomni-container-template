# Rename this file to biomni.env and fill in real values. Never commit the
# real biomni.env — it's already covered by .gitignore.

# Anthropic API key (used if LLM_SOURCE=Anthropic or left unset)
ANTHROPIC_API_KEY=

# --- AWS Bedrock (optional, recommended) ---
# Set LLM_SOURCE=Bedrock to route through AWS Bedrock instead of the direct
# Anthropic API. Requires an EC2/ECS instance role (or equivalent) with
# bedrock:InvokeModel permissions — do not put AWS access keys here.
LLM_SOURCE=Bedrock
AWS_REGION=us-west-2

# Secret used for your app's own admin/auth routes, if applicable
ADMIN_PASSWORD=
